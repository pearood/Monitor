# 复制本文件为 config/doubao.env 后填写你自己的 Doubao / 火山方舟 Key。
# 文本/图片模型走 Ark API Key。
# 语音播报默认走豆包语音合成 2.0，需要填写 Speech AppID / API Key。
# 语音识别走豆包录音文件极速识别，需要另外填写 ASR API Key。

DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seed-1-6-vision-250815
DOUBAO_TIMEOUT=18

# Doubao TTS 2.0, recommended for 小睿语音播报.
# 2.0 走 /api/v3/tts/unidirectional；需要使用支持 seed-tts-2.0 的应用 APP ID。
DOUBAO_TTS_VERSION=2
DOUBAO_SPEECH_APPID=your-doubao-tts-2-app-id
DOUBAO_TTS_API_KEY=your-doubao-tts-2-api-key
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# 可选音色：
# 小何 2.0：zh_female_xiaohe_uranus_bigtts
# Vivi 2.0：zh_female_vv_uranus_bigtts
# 云舟 2.0：zh_male_m191_uranus_bigtts
# 小天 2.0：zh_male_taocheng_uranus_bigtts
DOUBAO_TTS_VOICE_TYPE=zh_female_xiaohe_uranus_bigtts
DOUBAO_TTS_ENCODING=mp3
DOUBAO_TTS_RATE=24000

# Doubao TTS 1.0 fallback. 仅旧接口需要 Access Token / cluster。
# 如果你以后要切回 1.0，可改为：
# DOUBAO_TTS_VERSION=1
# DOUBAO_SPEECH_APPID=your-doubao-speech-appid
# DOUBAO_SPEECH_TOKEN=your-doubao-speech-token
# DOUBAO_TTS_CLUSTER=volcano_tts
# DOUBAO_TTS_VOICE_TYPE=BV700_streaming
# DOUBAO_TTS_ENCODING=mp3
# DOUBAO_TTS_RATE=24000
DOUBAO_ASR_API_KEY=your-doubao-asr-api-key
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
